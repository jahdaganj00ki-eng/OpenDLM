<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OpenDLM.Tests</RootNamespace>
    <AssemblyName>OpenDLM.Tests</AssemblyName>
    <!--
      A deliberately dependency-free test runner.
      No xunit and no nunit means no NuGet packages, so the whole repository
      builds and tests completely offline.
      Run it with the build script, or from this folder: dotnet run
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenDLM.Core\OpenDLM.Core.csproj" />
  </ItemGroup>

</Project>
