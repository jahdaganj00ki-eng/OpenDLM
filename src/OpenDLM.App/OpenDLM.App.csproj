<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is used only for the tray icon (NotifyIcon) and native folder pickers. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>OpenDLM.App</RootNamespace>
    <AssemblyName>OpenDLM</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>OpenDLM - free download manager for Windows.</Description>

    <!--
      Directory.Build.props turns invariant globalization on for the whole solution,
      which is right for the engine (it formats numbers itself and the tests assert
      on that output) and wrong for WPF: the first time a window needs a specific
      culture it throws "Cannot find non-neutral culture related to 'en-us'" and the
      application dies on startup. This is the one project that opts out.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenDLM.Core\OpenDLM.Core.csproj" />
  </ItemGroup>

  <!--
    The WinForms SDK adds global usings for System.Drawing and System.Windows.Forms
    whenever UseWindowsForms is on. Those collide with WPF across the whole project
    (Brush, Pen, Application, ComboBox, TextBox, CheckBox, DragEventArgs, ...), so
    they are removed here. The few files that genuinely need them - the tray icon
    and the folder picker - import them explicitly instead.
  -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <!--
    The WPF SDK leaves System.IO out of the implicit usings, because a global
    using for it would make Path ambiguous with System.Windows.Shapes.Path. The
    application uses System.IO.Path, File and Directory far more often than the
    Shape, so it is added back globally here.
  -->
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
