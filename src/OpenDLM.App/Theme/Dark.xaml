<!--
    OpenDLM dark palette.
    Key-for-key identical to Light.xaml so the theme can be swapped by replacing
    the dictionary without any control losing a brush.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Window"        Color="#FF1E1F22" />
    <SolidColorBrush x:Key="Brush.Panel"         Color="#FF26272B" />
    <SolidColorBrush x:Key="Brush.PanelAlt"      Color="#FF2B2D31" />
    <SolidColorBrush x:Key="Brush.Toolbar"       Color="#FF2B2D31" />
    <SolidColorBrush x:Key="Brush.MenuBar"       Color="#FF26272B" />
    <SolidColorBrush x:Key="Brush.StatusBar"     Color="#FF2B2D31" />
    <SolidColorBrush x:Key="Brush.Header"        Color="#FF34363B" />
    <SolidColorBrush x:Key="Brush.HeaderHover"   Color="#FF3E4147" />
    <SolidColorBrush x:Key="Brush.HeaderPressed" Color="#FF4A4D54" />
    <SolidColorBrush x:Key="Brush.DetailsPane"   Color="#FF232428" />

    <!-- Lines -->
    <SolidColorBrush x:Key="Brush.Border"        Color="#FF44474D" />
    <SolidColorBrush x:Key="Brush.BorderStrong"  Color="#FF5C6068" />
    <SolidColorBrush x:Key="Brush.GridLine"      Color="#FF34363B" />
    <SolidColorBrush x:Key="Brush.Separator"     Color="#FF3E4147" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.Text"          Color="#FFE6E7EA" />
    <SolidColorBrush x:Key="Brush.TextMuted"     Color="#FFA0A5AD" />
    <SolidColorBrush x:Key="Brush.TextDisabled"  Color="#FF6C7179" />
    <SolidColorBrush x:Key="Brush.TextOnAccent"  Color="#FFFFFFFF" />

    <!-- Accent and interaction states -->
    <SolidColorBrush x:Key="Brush.Accent"        Color="#FF3D8BDC" />
    <SolidColorBrush x:Key="Brush.AccentHover"   Color="#FF529AE6" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF2F73BC" />
    <SolidColorBrush x:Key="Brush.Selection"     Color="#FF2C4A68" />
    <SolidColorBrush x:Key="Brush.SelectionInactive" Color="#FF333A44" />
    <SolidColorBrush x:Key="Brush.Hover"         Color="#FF333840" />
    <SolidColorBrush x:Key="Brush.Pressed"       Color="#FF3C424B" />

    <!-- Progress and status -->
    <SolidColorBrush x:Key="Brush.Progress"      Color="#FF4CAF50" />
    <SolidColorBrush x:Key="Brush.ProgressTrack" Color="#FF3A3D43" />
    <SolidColorBrush x:Key="Brush.ProgressText"  Color="#FFE6E7EA" />
    <SolidColorBrush x:Key="Brush.Error"         Color="#FFE05C4B" />
    <SolidColorBrush x:Key="Brush.Success"       Color="#FF66BB6A" />
    <SolidColorBrush x:Key="Brush.Warning"       Color="#FFE0A64B" />

    <!-- Scrollbars -->
    <SolidColorBrush x:Key="Brush.ScrollTrack"       Color="#FF232428" />
    <SolidColorBrush x:Key="Brush.ScrollThumb"       Color="#FF4A4D54" />
    <SolidColorBrush x:Key="Brush.ScrollThumbHover"  Color="#FF63676F" />

</ResourceDictionary>
