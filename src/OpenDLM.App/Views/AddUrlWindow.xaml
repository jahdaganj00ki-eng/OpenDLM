<Window x:Class="OpenDLM.App.Views.AddUrlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a download"
        Width="580"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontSize="{DynamicResource Size.FontNormal}">

    <StackPanel Margin="14">

        <TextBlock Text="Address" FontWeight="SemiBold" />
        <TextBox x:Name="UrlBox"
                 Height="62"
                 Margin="0,3,0,0"
                 AcceptsReturn="True"
                 AcceptsTab="False"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 ToolTip="One URL per line. OpenDLM probes each address before downloading." />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Save to" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="DirectoryBox" />
            <Button Grid.Column="2" Margin="6,0,0,0" Content="Browse..." Click="OnBrowse" />
        </Grid>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="File name" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="FileNameBox" ToolTip="Leave empty to use the server's name" />
            <TextBlock Grid.Column="2" Margin="10,0,0,0" Text="Category" VerticalAlignment="Center" />
            <ComboBox Grid.Column="3" x:Name="CategoryBox" />
        </Grid>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Description" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="DescriptionBox" />
            <TextBlock Grid.Column="2" Margin="10,0,0,0" Text="Queue" VerticalAlignment="Center" />
            <ComboBox Grid.Column="3" x:Name="QueueBox" />
        </Grid>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Connections" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" x:Name="ConnectionsBox" Width="90" HorizontalAlignment="Left"
                      ToolTip="Simultaneous connections used for this download" />
            <TextBlock Grid.Column="2" Margin="10,0,0,0" Text="Referer" VerticalAlignment="Center" />
            <TextBox Grid.Column="3" x:Name="RefererBox" />
        </Grid>

        <CheckBox x:Name="StartNowBox"
                  Margin="0,12,0,0"
                  Content="Start the download immediately"
                  IsChecked="True" />

        <GroupBox Margin="0,10,0,0" Header="Authentication (only if the server asks for it)">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="User name" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" x:Name="UserBox" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" Text="Password" VerticalAlignment="Center" />
                <PasswordBox Grid.Column="3" x:Name="PasswordBox" />
            </Grid>
        </GroupBox>

        <Border Margin="0,12,0,0"
                Padding="8"
                Background="{DynamicResource Brush.PanelAlt}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="3">
            <TextBlock x:Name="HintText"
                       TextWrapping="Wrap"
                       Style="{StaticResource Style.Muted}"
                       Text="OpenDLM splits a file across several connections whenever the server supports byte ranges, and resumes interrupted downloads from the last complete block." />
        </Border>

        <StackPanel Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Download later" MinWidth="110" Click="OnAddToQueue" />
            <Button Content="_OK" IsDefault="True" MinWidth="88" Margin="8,0,0,0" Click="OnOk" />
            <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
