<Window x:Class="OpenDLM.App.Views.ZipPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Archive contents"
        Width="660"
        Height="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontSize="{DynamicResource Size.FontNormal}">

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="SummaryText" Margin="0,3,0,0"
                       Style="{StaticResource Style.Muted}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save this list" MinWidth="120" Click="OnSaveList" />
            <Button Content="Close" MinWidth="88" Margin="8,0,0,0" IsCancel="True" Click="OnClose" />
        </StackPanel>

        <ListView x:Name="EntryList" Margin="0,10,0,0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="330" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding Length, StringFormat={}{0:N0} B}" />
                    <GridViewColumn Header="Packed" Width="100" DisplayMemberBinding="{Binding CompressedLength, StringFormat={}{0:N0} B}" />
                    <GridViewColumn Header="Saved" Width="70" DisplayMemberBinding="{Binding Ratio, StringFormat={}{0} %}" />
                    <GridViewColumn Header="Modified" Width="140" DisplayMemberBinding="{Binding Modified, StringFormat=yyyy-MM-dd}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
