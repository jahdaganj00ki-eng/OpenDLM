<Window x:Class="OpenDLM.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About OpenDLM"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontSize="{DynamicResource Size.FontNormal}">

    <StackPanel Margin="18">

        <StackPanel Orientation="Horizontal">
            <Path Width="44" Height="44"
                  VerticalAlignment="Center"
                  Fill="{DynamicResource Brush.Accent}"
                  Data="{StaticResource Icon.Add}" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" Text="OpenDLM" />
                <TextBlock x:Name="VersionText" Style="{StaticResource Style.Muted}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Margin="0,16,0,0"
                   TextWrapping="Wrap"
                   Text="A free download manager for Windows. Free forever: no trial period, no licence key, no advertising and no feature held back. OpenDLM is published under the MIT licence, so you are free to read it, change it and pass it on." />

        <TextBlock Margin="0,12,0,0"
                   FontWeight="SemiBold"
                   Text="Independence" />

        <TextBlock Margin="0,3,0,0"
                   TextWrapping="Wrap"
                   Style="{StaticResource Style.Muted}"
                   Text="OpenDLM is an independent, from-scratch project. It is not affiliated with, endorsed by, or derived from any commercial download manager, and it contains no third-party binaries, icons, artwork, translation tables or documentation. Every feature is reimplemented from public behaviour and every asset is generated by this project's own code." />

        <TextBlock Margin="0,12,0,0"
                   FontWeight="SemiBold"
                   Text="This build" />

        <TextBox x:Name="BuildText"
                 Margin="0,3,0,0"
                 IsReadOnly="True"
                 BorderThickness="0"
                 Background="Transparent"
                 TextWrapping="Wrap"
                 FontFamily="Consolas, Courier New"
                 FontSize="11" />

        <TextBlock Margin="0,12,0,0"
                   FontWeight="SemiBold"
                   Text="Privacy" />

        <TextBlock Margin="0,3,0,0"
                   TextWrapping="Wrap"
                   Style="{StaticResource Style.Muted}"
                   Text="OpenDLM has no telemetry and no analytics. It makes network requests only for the downloads you ask it to make." />

        <StackPanel Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Settings folder" MinWidth="110" Click="OnOpenDataFolder" />
            <Button Content="Log folder" MinWidth="90" Margin="8,0,0,0" Click="OnOpenLogFolder" />
            <Button Content="_Close" IsDefault="True" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
