<Window x:Class="OpenDLM.App.Views.TextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenDLM"
        Width="820"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontSize="{DynamicResource Size.FontNormal}">

    <DockPanel Margin="10">
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="PathText"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource Style.Muted}" />

                <Button Grid.Column="1" Content="Copy" MinWidth="80" Click="OnCopy" />
                <Button Grid.Column="2" Content="Save as..." MinWidth="90" Margin="8,0,0,0" Click="OnSaveAs" />
            </Grid>
        </Border>

        <TextBox x:Name="ContentBox"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas, Courier New"
                 FontSize="11" />
    </DockPanel>
</Window>
