<Window x:Class="OpenDLM.App.Views.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenDLM options"
        Width="760"
        Height="640"
        MinWidth="680"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontSize="{DynamicResource Size.FontNormal}">

    <DockPanel Margin="10">

        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Reset everything" MinWidth="120" Click="OnResetAll" />
                <TextBlock Grid.Column="1"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource Style.Muted}"
                           x:Name="FootNote" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="_OK" IsDefault="True" MinWidth="88" Click="OnOk" />
                    <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="Tabs">

            <!-- ======================================================= General -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Downloads" Style="{StaticResource Style.SectionHeading}" />
                        <CheckBox x:Name="CaptureDownloadsBox" Content="Take over downloads from the browser" />
                        <CheckBox x:Name="WarnDuplicateBox" Margin="0,5,0,0" Content="Warn when the same link is added a second time" />
                        <CheckBox x:Name="RememberDuplicateBox" Margin="0,5,0,0" Content="Remember that answer for the address" />
                        <CheckBox x:Name="ClipboardBox" Margin="0,5,0,0" Content="Watch the clipboard for download links" />

                        <TextBlock Text="Dialogs" Style="{StaticResource Style.SectionHeading}" />
                        <CheckBox x:Name="ShowStartBox" Content="Show the start download dialog" />
                        <CheckBox x:Name="ShowCompleteBox" Margin="0,5,0,0" Content="Show the download complete dialog" />
                        <CheckBox x:Name="ShowErrorBox" Margin="0,5,0,0" Content="Show a dialog when a download fails" />
                        <CheckBox x:Name="ConfirmExitBox" Margin="0,5,0,0" Content="Ask before closing OpenDLM" />

                        <TextBlock Text="Takeover keys" Style="{StaticResource Style.SectionHeading}" />
                        <TextBlock Text="Force takeover while holding" Style="{StaticResource Style.SectionHeading}" />
                        <WrapPanel>
                            <CheckBox x:Name="ForceAltBox" Margin="0,0,14,5" Content="Alt" />
                            <CheckBox x:Name="ForceCtrlBox" Margin="0,0,14,5" Content="Ctrl" />
                            <CheckBox x:Name="ForceShiftBox" Margin="0,0,14,5" Content="Shift" />
                        </WrapPanel>

                        <TextBlock Text="Let the browser keep it while holding" Style="{StaticResource Style.SectionHeading}" />
                        <WrapPanel>
                            <CheckBox x:Name="PreventAltBox" Margin="0,0,14,5" Content="Alt" />
                            <CheckBox x:Name="PreventCtrlBox" Margin="0,0,14,5" Content="Ctrl" />
                            <CheckBox x:Name="PreventShiftBox" Margin="0,0,14,5" Content="Shift" />
                        </WrapPanel>

                        <TextBlock Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource Style.Muted}"
                                   Text="The two lists are independent: you can force a takeover with Alt while preventing one with Ctrl, which is what lets several bindings be active at once. Selecting none of them, or turning off the switches below, disables that direction entirely." />

                        <CheckBox x:Name="EnableForceKeyBox" Margin="0,8,0,0" Content="Honour the force takeover key" />
                        <CheckBox x:Name="EnablePreventKeyBox" Margin="0,5,0,0" Content="Honour the let-the-browser-keep-it key" />
                        <CheckBox x:Name="CheckMouseBox" Margin="0,5,0,0" Content="Also react to middle-click and modifier-click" />
                        <CheckBox x:Name="SkipHtmlBox" Margin="0,5,0,0" Content="Never take over plain web page navigations" />

                        <TextBlock Text="Start-up" Style="{StaticResource Style.SectionHeading}" />
                        <CheckBox x:Name="StartWithWindowsBox" Content="Start OpenDLM when Windows starts" />
                        <CheckBox x:Name="StartMinimizedBox" Margin="0,5,0,0" Content="Start minimised in the notification area" />
                        <CheckBox x:Name="MinimizeToTrayBox" Margin="0,5,0,0" Content="Closing the window keeps OpenDLM running in the notification area" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================================================== Downloads -->
            <TabItem Header="Downloads">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">

                        <TextBlock Text="Folder" Style="{StaticResource Style.SectionHeading}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="DefaultFolderBox" />
                            <Button Grid.Column="1" Margin="6,0,0,0" Content="Browse..." Click="OnBrowseDefaultFolder" />
                        </Grid>

                        <CheckBox x:Name="UseCategoryFoldersBox" Margin="0,8,0,0"
                                  Content="File downloads into a sub-folder that matches their category" />

                        <TextBlock Text="Category folders" Style="{StaticResource Style.SectionHeading}" />
                        <Grid x:Name="CategoryFolderGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Video" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2" x:Name="FolderVideoBox" />
                            <Button Grid.Row="0" Grid.Column="2" Margin="6,2,0,2" Content="..." Click="OnBrowseFolderVideo" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Music" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" x:Name="FolderMusicBox" />
                            <Button Grid.Row="1" Grid.Column="2" Margin="6,2,0,2" Content="..." Click="OnBrowseFolderMusic" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Programs" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" x:Name="FolderProgramsBox" />
                            <Button Grid.Row="2" Grid.Column="2" Margin="6,2,0,2" Content="..." Click="OnBrowseFolderPrograms" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Documents" VerticalAlignment="Center" />
                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" x:Name="FolderDocumentsBox" />
                            <Button Grid.Row="3" Grid.Column="2" Margin="6,2,0,2" Content="..." Click="OnBrowseFolderDocuments" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Compressed" VerticalAlignment="Center" />
                            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,2" x:Name="FolderCompressedBox" />
                            <Button Grid.Row="4" Grid.Column="2" Margin="6,2,0,2" Content="..." Click="OnBrowseFolderCompressed" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Other" VerticalAlignment="Center" />
                            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,2" x:Name="FolderOtherBox" />
                            <Button Grid.Row="5" Grid.Column="2" Margin="6,2,0,2" Content="..." Click="OnBrowseFolderOther" />
                        </Grid>

                        <TextBlock Text="Behaviour" Style="{StaticResource Style.SectionHeading}" />
                        <CheckBox x:Name="StartAutomaticallyBox" Content="Start new downloads immediately" />
                        <CheckBox x:Name="AddToQueueBox" Margin="0,5,0,0" Content="Add new downloads to the queue instead" />
                        <CheckBox x:Name="ResumeOnStartupBox" Margin="0,5,0,0" Content="Resume unfinished downloads when OpenDLM starts" />
                        <CheckBox x:Name="AutoRetryBox" Margin="0,5,0,0" Content="Retry failed downloads automatically" />
                        <CheckBox x:Name="VerifySizeBox" Margin="0,5,0,0" Content="Verify the received size against the server's" />
                        <CheckBox x:Name="ChecksumsBox" Margin="0,5,0,0" Content="Compute MD5 and SHA-1 checksums when a download finishes" />
                        <CheckBox x:Name="RememberLastSaveBox" Margin="0,5,0,0" Content="Remember the folder of the last download as the default" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="If the file already exists" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2" x:Name="ExistingFileBox" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Progress window" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2" x:Name="ProgressDialogBox" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Do not take over files smaller than" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" x:Name="MinSizeBox" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="8,0,0,0" Text="KB (0 takes over everything)" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="After a download finishes" Style="{StaticResource Style.SectionHeading}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Action" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2" x:Name="PostActionBox" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Open with" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" x:Name="OpenWithBox" />
                            <Button Grid.Row="1" Grid.Column="2" Margin="6,2,0,2" HorizontalAlignment="Left" Content="Browse..." Click="OnBrowseOpenWith" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Antivirus program" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" x:Name="AntivirusBox" />
                            <Button Grid.Row="2" Grid.Column="2" Margin="6,2,0,2" HorizontalAlignment="Left" Content="Browse..." Click="OnBrowseAntivirus" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================================================== File types -->
            <TabItem Header="File types">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               TextWrapping="Wrap"
                               Style="{StaticResource Style.Muted}"
                               Text="These rules decide which downloads OpenDLM takes over from the browser, and which category each file type is filed under." />

                    <ListView Grid.Row="1" Margin="0,8,0,0" x:Name="FileTypeList" SelectionMode="Extended">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Type" Width="120" DisplayMemberBinding="{Binding Mask}" />
                                <GridViewColumn Header="Take over" Width="130" DisplayMemberBinding="{Binding Action}" />
                                <GridViewColumn Header="Category" Width="140" DisplayMemberBinding="{Binding Category}" />
                                <GridViewColumn Header="Notes" Width="180" DisplayMemberBinding="{Binding Description}" />
                                <GridViewColumn Header="Folder" Width="200" DisplayMemberBinding="{Binding Folder}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Set the selected entries to" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Margin="8,0,0,0" x:Name="FileTypeActionBox" SelectionChanged="OnFileTypeActionChanged" />
                        <TextBlock Grid.Column="2" Margin="12,0,0,0" Text="Category" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="3" Margin="8,0,0,0" Width="140" x:Name="FileTypeCategoryBox" SelectionChanged="OnFileTypeCategoryChanged" />
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,10,0,0" Orientation="Horizontal">
                        <TextBox x:Name="NewExtensionBox" Width="110" ToolTip="For example: iso" />
                        <Button Margin="6,0,0,0" Content="Add type" MinWidth="90" Click="OnAddFileType" />
                        <Button Margin="8,0,0,0" Content="Remove selected" MinWidth="120" Click="OnRemoveFileType" />
                        <Button Margin="8,0,0,0" Content="Set folder..." MinWidth="100" Click="OnSetFileTypeFolder" />
                        <Button Margin="8,0,0,0" Content="Restore defaults" MinWidth="120" Click="OnRestoreFileTypes" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===================================================== Connection -->
            <TabItem Header="Connection">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Segments" Style="{StaticResource Style.SectionHeading}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Connections per download" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2" x:Name="MaxConnectionsBox" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" Text="1 to 32" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Downloads at the same time" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" x:Name="MaxConcurrentBox" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" Text="1 to 50" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Retries per download" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" x:Name="RetryCountBox" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Seconds between retries" VerticalAlignment="Center" />
                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" x:Name="RetryDelayBox" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Server timeout" VerticalAlignment="Center" />
                            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,2" x:Name="TimeoutBox" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Margin="8,0,0,0" Text="seconds" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Maximum redirects" VerticalAlignment="Center" />
                            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,2" x:Name="MaxRedirectsBox" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Maximum speed" VerticalAlignment="Center" />
                            <TextBox Grid.Row="6" Grid.Column="1" Margin="0,2" x:Name="SpeedLimitBox" />
                            <TextBlock Grid.Row="6" Grid.Column="2" Margin="8,0,0,0" Text="KB per second, 0 for unlimited" VerticalAlignment="Center" />

                            <CheckBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0"
                                      x:Name="LimitSpeedBox" Content="Limit the download speed" />
                        </Grid>

                        <TextBlock Text="User agent" Style="{StaticResource Style.SectionHeading}" />
                        <CheckBox x:Name="CustomAgentBox" Content="Send a custom User-Agent" />
                        <TextBox x:Name="AgentBox" Margin="0,5,0,0" />

                        <TextBlock Text="Compatibility" Style="{StaticResource Style.SectionHeading}" />
                        <CheckBox x:Name="HeadProbeBox" Content="Probe the size with a HEAD request first" />
                        <CheckBox x:Name="FallbackBox" Margin="0,5,0,0" Content="Fall back to a single connection when the server ignores byte ranges" />
                        <CheckBox x:Name="IgnoreCertsBox" Margin="0,5,0,0" Content="Accept invalid TLS certificates (not recommended)" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================================================== Proxy -->
            <TabItem Header="Proxy">
                <StackPanel Margin="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Use" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3" x:Name="ProxyModeBox" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Server" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" x:Name="ProxyAddressBox" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Port" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Width="100" HorizontalAlignment="Left" x:Name="ProxyPortBox" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="User name" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,3" x:Name="ProxyUserBox" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Password" VerticalAlignment="Center" />
                        <PasswordBox Grid.Row="4" Grid.Column="1" Margin="0,3" x:Name="ProxyPasswordInput" />
                    </Grid>

                    <CheckBox x:Name="ProxyBypassLocalBox" Margin="0,10,0,0" Content="Bypass the proxy for local addresses" />

                    <TextBlock Text="Use the proxy for" Style="{StaticResource Style.SectionHeading}" />
                    <WrapPanel>
                        <CheckBox x:Name="ProxyHttpBox" Margin="0,0,16,5" Content="HTTP" />
                        <CheckBox x:Name="ProxyHttpsBox" Margin="0,0,16,5" Content="HTTPS" />
                        <CheckBox x:Name="ProxyFtpBox" Margin="0,0,16,5" Content="FTP" />
                    </WrapPanel>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Dialect" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3" x:Name="SocksTypeBox" />
                        <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,5,0,0"
                                  x:Name="SocksDnsBox" Content="Let the SOCKS5 proxy resolve names" />
                    </Grid>

                    <TextBlock Text="Proxy auto-configuration (PAC) script" Style="{StaticResource Style.SectionHeading}" />
                    <TextBox x:Name="PacUrlBox"
                             ToolTip="A file path or an http(s) URL. Windows evaluates it for every destination, so one script can route different hosts differently." />
                    <TextBlock Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource Style.Muted}"
                               Text="Only used by the automatic mode. Windows runs the script itself, so everything a PAC script can do works here, including per-host routing and DIRECT results." />

                    <TextBlock Text="Take the proxy from the browser" Style="{StaticResource Style.SectionHeading}" />
                    <WrapPanel>
                        <CheckBox x:Name="ProxyFromBrowserHttpBox" Margin="0,0,14,5" Content="HTTP" />
                        <CheckBox x:Name="ProxyFromBrowserHttpsBox" Margin="0,0,14,5" Content="HTTPS" />
                        <CheckBox x:Name="ProxyFromBrowserFtpBox" Margin="0,0,14,5" Content="FTP" />
                    </WrapPanel>
                    <CheckBox x:Name="UseBrowserProxyOnFailureBox" Margin="0,5,0,0"
                              Content="Retry a browser download through the browser's proxy when it fails" />
                    <CheckBox x:Name="MicrosoftTls13Box" Margin="0,5,0,0"
                              Content="Use Microsoft's TLS 1.3 (experimental)" />

                    <TextBlock Text="Connect directly to these hosts" Style="{StaticResource Style.SectionHeading}" />
                    <TextBox x:Name="ProxyExceptionsBox"
                             Height="80"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Courier New"
                             ToolTip="One host or domain per line. A leading dot includes sub-domains." />

                    <TextBlock Margin="0,14,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource Style.Muted}"
                               Text="Choosing the system setting reuses whatever Windows is configured with, including a PAC script." />
                </StackPanel>
            </TabItem>

            <!-- =================================================== Sites logins -->
            <TabItem Header="Sites logins">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               TextWrapping="Wrap"
                               Style="{StaticResource Style.Muted}"
                               Text="Credentials for protected servers. They are used automatically whenever a download starts from a matching address." />

                    <ListView Grid.Row="1" Margin="0,8,0,0" x:Name="LoginList" SelectionChanged="OnLoginSelected">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Server" Width="260" DisplayMemberBinding="{Binding Server}" />
                                <GridViewColumn Header="User name" Width="180" DisplayMemberBinding="{Binding Username}" />
                                <GridViewColumn Header="All paths" Width="80" DisplayMemberBinding="{Binding UseForAllPaths}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <GroupBox Grid.Row="2" Margin="0,10,0,0" Header="Entry">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Server" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,3" x:Name="LoginServerBox" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="10,0,0,0" Text="User name" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="3" Margin="0,3" x:Name="LoginUserBox" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Password" VerticalAlignment="Center" />
                            <PasswordBox Grid.Row="1" Grid.Column="1" Margin="0,3" x:Name="LoginPasswordInput" />
                            <CheckBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="10,3,0,0"
                                      x:Name="LoginAllPathsBox" Content="Use for every path on this server" />

                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Orientation="Horizontal">
                                <Button Content="Save entry" MinWidth="100" Click="OnSaveLogin" />
                                <Button Content="New entry" MinWidth="100" Margin="8,0,0,0" Click="OnNewLogin" />
                                <Button Content="Remove" MinWidth="90" Margin="8,0,0,0" Click="OnRemoveLogin" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ====================================================== Sounds -->
            <TabItem Header="Sounds">
                <StackPanel Margin="12">
                    <CheckBox x:Name="SoundsEnabledBox" Content="Play a sound for events" />

                    <TextBlock Text="Sound for each event" Style="{StaticResource Style.SectionHeading}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Starts" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3" x:Name="StartSoundBox" IsEditable="True" />
                        <Button Grid.Row="0" Grid.Column="2" Margin="6,3,0,3" Content="Play" Click="OnPlayStartSound" />
                        <Button Grid.Row="0" Grid.Column="3" Margin="6,3,0,3" Content="..." Click="OnBrowseStartSound" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Finishes" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3" x:Name="CompleteSoundBox" IsEditable="True" />
                        <Button Grid.Row="1" Grid.Column="2" Margin="6,3,0,3" Content="Play" Click="OnPlayCompleteSound" />
                        <Button Grid.Row="1" Grid.Column="3" Margin="6,3,0,3" Content="..." Click="OnBrowseCompleteSound" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Fails" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,3" x:Name="ErrorSoundBox" IsEditable="True" />
                        <Button Grid.Row="2" Grid.Column="2" Margin="6,3,0,3" Content="Play" Click="OnPlayErrorSound" />
                        <Button Grid.Row="2" Grid.Column="3" Margin="6,3,0,3" Content="..." Click="OnBrowseErrorSound" />
                    </Grid>

                    <WrapPanel Margin="0,10,0,0">
                        <CheckBox x:Name="PlayOnStartBox" Margin="0,0,14,5" Content="When a download starts" />
                        <CheckBox x:Name="PlayOnCompleteBox" Margin="0,0,14,5" Content="When a download finishes" />
                        <CheckBox x:Name="PlayOnErrorBox" Margin="0,0,14,5" Content="When a download fails" />
                    </WrapPanel>

                    <CheckBox x:Name="BalloonOnCompleteBox" Margin="0,5,0,0"
                              Content="Also show a notification when a download finishes" />

                    <TextBlock Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource Style.Muted}"
                               Text="Sound files are WAV. Use Play to hear a choice before you save it." />
                </StackPanel>
            </TabItem>

            <!-- ============================================ Per-site rules -->
            <TabItem Header="Sites">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               TextWrapping="Wrap"
                               Style="{StaticResource Style.Muted}"
                               Text="Some servers ignore byte ranges or corrupt multi-part requests. List those hosts here and OpenDLM always fetches them over a single connection, whatever the global setting says." />

                    <ListView Grid.Row="1"
                              Margin="0,8,0,0"
                              x:Name="SiteExceptionList"
                              SelectionChanged="OnSiteExceptionSelected">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Host" Width="260" DisplayMemberBinding="{Binding Host}" />
                                <GridViewColumn Header="Single connection" Width="130" DisplayMemberBinding="{Binding UseSingleConnection}" />
                                <GridViewColumn Header="Note" Width="220" DisplayMemberBinding="{Binding Note}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Host" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 x:Name="SiteExceptionHostBox"
                                 ToolTip="For example files.example.com, or .example.com to include sub-domains" />
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,10,0,0" Orientation="Horizontal">
                        <CheckBox x:Name="SiteExceptionSingleBox"
                                  VerticalAlignment="Center"
                                  Content="Always use a single connection"
                                  IsChecked="True" />
                        <Button Margin="16,0,0,0" Content="Add host" MinWidth="90" Click="OnAddSiteException" />
                        <Button Margin="8,0,0,0" Content="Remove selected" MinWidth="120" Click="OnRemoveSiteException" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- =============================================== Browser integration -->
            <TabItem Header="Browser">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <CheckBox x:Name="BrowserEnabledBox" FontWeight="SemiBold" Content="Enable the browser integration" />

                        <TextBlock Text="Browsers" Style="{StaticResource Style.SectionHeading}" />
                        <WrapPanel>
                            <CheckBox x:Name="ChromeBox" Margin="0,0,16,5" Content="Chrome" />
                            <CheckBox x:Name="EdgeBox" Margin="0,0,16,5" Content="Edge" />
                            <CheckBox x:Name="FirefoxBox" Margin="0,0,16,5" Content="Firefox" />
                            <CheckBox x:Name="BraveBox" Margin="0,0,16,5" Content="Brave" />
                            <CheckBox x:Name="OperaBox" Margin="0,0,16,5" Content="Opera" />
                            <CheckBox x:Name="VivaldiBox" Margin="0,0,16,5" Content="Vivaldi" />
                        </WrapPanel>

                        <TextBlock Text="What the extension may do" Style="{StaticResource Style.SectionHeading}" />
                        <CheckBox x:Name="TakeOverBrowserBox" Content="Take over downloads the browser starts itself" />
                        <CheckBox x:Name="ContextMenuBox" Margin="0,5,0,0" Content="Add the OpenDLM entries to the browser context menu" />
                        <StackPanel Margin="22,5,0,0">
                            <CheckBox x:Name="ContextMenuLinkBox" Content="&quot;Download with OpenDLM&quot; on a link" />
                            <CheckBox x:Name="ContextMenuAllBox" Margin="0,4,0,0" Content="&quot;Download all links with OpenDLM&quot; on a page" />
                            <CheckBox x:Name="ContextMenuMediaBox" Margin="0,4,0,0" Content="&quot;Download this media with OpenDLM&quot; on video, audio and images" />
                        </StackPanel>
                        <CheckBox x:Name="MediaOverlayBox" Margin="0,5,0,0" Content="Offer a download badge over detected video and audio" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Ignore browser downloads smaller than" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Margin="0,2" x:Name="BrowserMinSizeBox" />
                            <TextBlock Grid.Column="2" Margin="8,0,0,0" Text="KB" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Types the extension should claim" Style="{StaticResource Style.SectionHeading}" />
                        <TextBox x:Name="TakeOverExtensionsBox"
                                 Height="110"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, Courier New"
                                 ToolTip="One extension per line, with or without a dot" />

                        <TextBlock Text="Types to leave to the browser" Style="{StaticResource Style.SectionHeading}" />
                        <TextBox x:Name="ExcludedExtensionsBox"
                                 Height="80"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, Courier New" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================================================== Interface -->
            <TabItem Header="Interface">
                <StackPanel Margin="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Theme" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Margin="0,3" x:Name="ThemeBox" />
                    </Grid>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Toolbar layout" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Margin="0,3" x:Name="ToolbarStyleBox" />
                    </Grid>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Toolbar icon size" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Margin="0,3" x:Name="ToolbarIconSizeBox" />
                    </Grid>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Interface font" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Margin="0,3" x:Name="FontFamilyBox" ToolTip="A font family name, for example Segoe UI. Leave empty for the system default." />
                        <Button Grid.Column="2" Margin="6,3,0,3" Content="Default" Click="OnResetFont" />
                    </Grid>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Font size" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Width="70" Margin="0,3" x:Name="FontSizeBox" />
                        <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Style.Muted}" Text="points" />
                    </Grid>

                    <TextBlock Text="Language" Style="{StaticResource Style.SectionHeading}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Style.Muted}"
                                   Text="OpenDLM ships in English only. Other languages must be written from scratch." />
                    </StackPanel>

                    <TextBlock Text="Panes" Style="{StaticResource Style.SectionHeading}" />
                    <CheckBox x:Name="ShowCategoryPaneBox" Content="Show the category pane" />
                    <CheckBox x:Name="ShowDetailsPaneBox" Margin="0,5,0,0" Content="Show the details pane and throughput graph" />
                    <CheckBox x:Name="ShowToolbarBox" Margin="0,5,0,0" Content="Show the toolbar" />
                    <CheckBox x:Name="ShowStatusBarBox" Margin="0,5,0,0" Content="Show the status bar" />

                    <TextBlock Text="Refresh" Style="{StaticResource Style.SectionHeading}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Status refresh interval" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Margin="0,2" x:Name="RefreshIntervalBox" />
                        <TextBlock Grid.Column="2" Margin="8,0,0,0" Text="milliseconds" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- ======================================================= Advanced -->
            <TabItem Header="Advanced">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <CheckBox x:Name="LoggingBox" Content="Write a diagnostic log file" />
                        <CheckBox x:Name="SendRefererBox" Margin="0,5,0,0" Content="Send the referer with the request" />
                        <CheckBox x:Name="SendCookiesBox" Margin="0,5,0,0" Content="Send the browser's cookies with the request" />
                        <CheckBox x:Name="BrowserIpcBox" Margin="0,5,0,0" Content="Listen for browser requests on the local pipe" />
                        <CheckBox x:Name="ProbeWithGetBox" Margin="0,5,0,0" Content="Retry the probe with a GET when HEAD is refused" />

                        <TextBlock Text="Notifications" Style="{StaticResource Style.SectionHeading}" />
                        <CheckBox x:Name="NotifyCompleteBox" Content="Tell me when a download finishes" />
                        <CheckBox x:Name="NotifyErrorBox" Margin="0,5,0,0" Content="Tell me when a download fails" />
                        <CheckBox x:Name="NotifyQueueStartBox" Margin="0,5,0,0" Content="Tell me when a scheduled queue window opens" />
                        <CheckBox x:Name="NotifyQueueFinishBox" Margin="0,5,0,0" Content="Tell me when a queue has drained" />

                        <TextBlock Text="Where OpenDLM keeps its data" Style="{StaticResource Style.SectionHeading}" />
                        <TextBox x:Name="PathsBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 TextWrapping="Wrap" FontFamily="Consolas, Courier New" FontSize="11" />

                        <TextBlock Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource Style.Muted}"
                                   Text="Set the environment variable OPEN_DLM_HOME before starting OpenDLM to keep settings, downloads and logs inside one folder — useful on a USB stick or for a clean test." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
