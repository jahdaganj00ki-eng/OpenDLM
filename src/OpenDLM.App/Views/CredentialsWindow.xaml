<Window x:Class="OpenDLM.App.Views.CredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Authentication required"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontSize="{DynamicResource Size.FontNormal}">

    <StackPanel Margin="14">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="User name" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="UserBox" />

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Text="Password" VerticalAlignment="Center" />
            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="PasswordInput" Margin="0,8,0,0" />
        </Grid>

        <CheckBox x:Name="RememberBox"
                  Margin="0,12,0,0"
                  Content="Remember these credentials for this server"
                  IsChecked="True" />

        <TextBlock Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Style="{StaticResource Style.Muted}"
                   Text="Stored passwords are encrypted with Windows DPAPI, so only your Windows account on this machine can read them back." />

        <StackPanel Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="_OK" IsDefault="True" MinWidth="88" Click="OnOk" />
            <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
