<?xml version="1.0" encoding="utf-8"?>
<!--
  OpenDLM deliberately has ZERO NuGet dependencies.
  Everything is built from the .NET 8 shared framework so the repository
  builds and runs fully offline. Clearing the package sources makes that
  guarantee explicit and prevents accidental network restores.
  If you ever add a PackageReference, remove the <clear /> below.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
